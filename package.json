{
  "name": "ghas-reporting-engine",
  "version": "1.0.0",
  "description": "GitHub Advanced Security reporting engine that maps security findings to compliance frameworks",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node src/index.ts",
    "cli-test": "ts-node src/cli-test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
